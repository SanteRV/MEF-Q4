# === Entorno virtual de Python ===
# Se recrea con: python -m venv venv  +  pip install -r requirements.txt
venv/
.venv/
env/
ENV/

# === Bytecode y cache de Python ===
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# === PyInstaller: salidas de build (NUNCA a git) ===
# IMPORTANTE: build_exe.spec y build_exe.bat SON fuente y SI se versionan.
# Se ignora unicamente lo GENERADO. dist/ contiene el ZIP de ~138 MB que
# supera el limite de 100 MB de GitHub y haria FALLAR el push por completo.
build/
dist/
*.manifest

# === Ejecutables y distribuibles generados ===
*.exe
*.zip

